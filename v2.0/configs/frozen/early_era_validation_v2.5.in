fco2_catboost_config = 700,10,0.02,12.0
fco2_catboost_weight = 0.3
interval_method = prediction_stratified

[policy]
later_labels_only = true
strict_nested_sss_for_fco2 = true
independent_labels_opened = false
labels_2026_opened = false
thresholds_may_be_derived_from_this_experiment = false

